# Must exactly match authentication-service JWT_SECRET_BASE64
JWT_SECRET_BASE64=BASE64_SECRET_SHARED_WITH_AUTH
SERVER_PORT=8085
HASHRING_VIRTUAL_NODES=150
REDIS_HOST=localhost
REDIS_PORT=6379
# Initial physical Atlas deployments. Leave unused values blank.
MONGO_SHARD1_NAME=shard1
MONGO_SHARD1_URI=mongodb+srv://USER:PASSWORD@CLUSTER1_HOST/products?retryWrites=true&w=majority
MONGO_SHARD1_DATABASE=products
MONGO_SHARD2_NAME=shard2
MONGO_SHARD2_URI=mongodb+srv://USER:PASSWORD@CLUSTER2_HOST/products?retryWrites=true&w=majority
MONGO_SHARD2_DATABASE=products
MONGO_SHARD3_NAME=shard3
MONGO_SHARD3_URI=mongodb+srv://USER:PASSWORD@CLUSTER3_HOST/products?retryWrites=true&w=majority
MONGO_SHARD3_DATABASE=products
