PRODUCT_SERVICE_URL=http://localhost:8081
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_SECONDS=60
CONNECT_TIMEOUT_MILLIS=2000
READ_TIMEOUT_SECONDS=4
