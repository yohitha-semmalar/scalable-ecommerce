SERVER_PORT=8084
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DATABASE=ecommerce
JWT_SECRET_BASE64=<copy-exact-base64-secret-from-auth-service>
