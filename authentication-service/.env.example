# Copy to your local environment or set these variables in your IDE.
# Do not put real secrets in a committed file.
MONGODB_URI=mongodb+srv://<db-user>:<password>@<cluster-host>/ecommerce?retryWrites=true&w=majority
MONGODB_DATABASE=ecommerce
JWT_SECRET_BASE64=REPLACE_WITH_A_RANDOM_BASE64_SECRET
JWT_EXPIRATION_SECONDS=3600
SERVER_PORT=8082
