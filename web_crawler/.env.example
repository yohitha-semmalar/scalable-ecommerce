# Environment Configuration for Member 5 Web Crawler Microservice
# Copy to .env or configure via Docker Compose / application.properties

PORT=8081
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Caching & Request Management
CACHE_TTL_SECONDS=60
CACHE_ENABLED=true
RATE_LIMIT_RPS=5
LOCK_TTL_SECONDS=5
LOCK_WAIT_TIMEOUT_MS=3000
BACKGROUND_INTERVAL_SECONDS=300
BACKGROUND_CRAWLER_ENABLED=true

# Mock Competitor Store Endpoints
AMAZON_MOCK_URL=http://localhost:8085
AMAZON_ENABLED=true

FLIPKART_MOCK_URL=http://localhost:8086
FLIPKART_ENABLED=true

MEESHO_MOCK_URL=http://localhost:8087
MEESHO_ENABLED=true

INSTAMART_MOCK_URL=http://localhost:8088
INSTAMART_ENABLED=true

# Simulation Controls for Testing
MOCK_DELAY_MS=0
MOCK_FAIL_RATE=0.0
